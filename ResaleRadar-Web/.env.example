# Copy to .env.local and fill in from Firebase console > Project settings > Your apps.
# Never commit .env.local. No project id or key belongs in source control.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional overrides
VITE_FUNCTIONS_REGION=us-central1
VITE_INVENTORY_COLLECTION=inventoryItems

# UI development only: in-memory sample data, no Firebase required.
VITE_USE_DEMO_DATA=false
